{
  "opencollection": "1.0.0",
  "info": {
    "name": "Itch.io Auth Search API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Search",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Search games",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.itch.io/search/games",
            "params": [
              {
                "name": "query",
                "value": "",
                "type": "query"
              },
              {
                "name": "page",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Performs a text search for games (or any project type). Games must be published and not deindexed."
        },
        {
          "info": {
            "name": "Search users",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.itch.io/search/users",
            "params": [
              {
                "name": "query",
                "value": "",
                "type": "query"
              },
              {
                "name": "page",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Performs a text search for users."
        }
      ]
    }
  ],
  "bundled": true
}